# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
ALLOWED_DISCORD_USER_ID=

# Local storage (Render overrides these to /var/data)
RESUME_DIRECTORY=./data
RESUME_PATH=./data/resume.pdf
RESUME_METADATA_PATH=./data/resume-meta.json
JOB_HISTORY_PATH=./data/sent-jobs.json
JOB_SOURCES_PATH=./data/sources.json

# Search preferences
JOB_LOCATION=Dubai, United Arab Emirates
PREFERRED_JOB_TITLES=Full Stack Developer,Backend Developer,Junior Software Engineer,JavaScript Developer,Node.js Developer,React Developer
MIN_MATCH_SCORE=70
MAX_REQUIRED_YEARS=3

# Automatic search schedule (Asia/Dubai)
AUTO_SEARCH_CRON=0 */6 * * *
